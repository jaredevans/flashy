# Flashy — terminal flash notifications for Claude Code
# Copy to ~/.config/flashy/config (or $XDG_CONFIG_HOME/flashy/config) and edit.
# Any value omitted falls back to the default shown here.

# Set to false to disable flashing without uninstalling
ENABLED=true

# Pulses per event type
STOP_PULSES=1           # Claude finished a turn
NOTIFICATION_PULSES=2   # permission prompt, idle prompt, MCP elicitation, agent needs input
WAITING_PULSES=2        # blocking on AskUserQuestion / plan approval
ERROR_PULSES=3          # turn ended on an API error (rate limit, overload, …)
IDLE_PULSES=2           # an agent-team teammate went idle

# Timing (seconds)
PULSE_DURATION=0.22
PULSE_GAP=0.1

# Color shift intensity (0-255 RGB steps)
# Higher = more visible flash. Lower = subtler.
SHIFT=50

# Fallback background color — SET THIS. Inside Claude Code it is not a
# fallback but the primary source: OSC 11 auto-detect cannot run from a hook
# (see README "How It Works"), so this is the color your background is
# restored to after every pulse. If it does not match your terminal's real
# background, each flash will leave your background subtly wrong.
FALLBACK_COLOR="#1a1b26"

# Background color file pattern (advanced — for multi-theme setups)
# If your shell writes the current bg color to a file, set the pattern here.
# Use {tty} as placeholder for the TTY name (e.g., ttys002).
# Example: ~/.terminal-bg-color.{tty}
BG_COLOR_FILE=""

# --- Apple Watch / Pushover notifications ---
# Sends a push (phone + Apple Watch) via https://pushover.net on each event.
# Leave PUSHOVER_USER_KEY or PUSHOVER_APP_TOKEN empty to disable.

PUSHOVER_ENABLED=true
PUSHOVER_USER_KEY=""
PUSHOVER_APP_TOKEN=""

# Notification text
PUSHOVER_TITLE="Claude Code"
PUSHOVER_STOP_MESSAGE="Claude finished a turn"
PUSHOVER_NOTIFICATION_MESSAGE="Claude needs your attention"
PUSHOVER_WAITING_MESSAGE="Claude is waiting for your input"
PUSHOVER_ERROR_MESSAGE="Claude hit an error and stopped"
PUSHOVER_IDLE_MESSAGE="A Claude teammate went idle"

# Pushover priority: -2 (silent) … 0 (default) … 2 (emergency)
PUSHOVER_PRIORITY=0

# Optional sound name (see https://pushover.net/api#sounds). Empty = user default.
PUSHOVER_SOUND=""

# Max seconds to wait on the Pushover API before giving up
PUSHOVER_TIMEOUT=5

# --- Debugging ---
# Set true to trace hook firing to ~/.config/flashy/debug.log — records which
# events fired, which terminal device was resolved, and the computed colors.
# The fastest way to tell "the hook never fired" from "the hook fired but the
# escape sequence went nowhere."
FLASHY_DEBUG=false
